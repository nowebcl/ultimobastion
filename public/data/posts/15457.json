e>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-15466\" data-id=\"15466\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-3-1024x576.jpeg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-3-1024x576.jpeg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-3-300x169.jpeg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-3-768x432.jpeg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-3-1536x864.jpeg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-3.jpeg 1600w\"/></figure>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-15467\" data-id=\"15467\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-1024x576.jpeg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-1024x576.jpeg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-300x169.jpeg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-768x432.jpeg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-06-at-1.25.34-PM-1536x864.jpeg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/10/WhatsApp-Image-2026-10-