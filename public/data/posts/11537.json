38-1024x682.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC4238-1024x682.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC4238-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC4238-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC4238-1536x1024.jpg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC4238.jpg 1772w\"/></figure>\n<figure class=\"wp-block-image aligncenter size-large\"><img alt=\"\" class=\"wp-image-11546\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC3625-1024x682.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC3625-1024x682.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC3625-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC3625-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC3625-1536x1024.jpg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC3625.jpg 1772w\"/></figure>\n<figure class=\"wp-block-image aligncenter size-large\"><img alt=\"\" class=\"wp-image-11547\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC_3903-1024x683.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC_3903-1024x683.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC_3903-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/DSC_3903-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2