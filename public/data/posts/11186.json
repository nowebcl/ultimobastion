osest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-10-1024x683.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-10-1024x683.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-10-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-10-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-10.jpg 1417w\"/></figure>\n</figure>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-11196\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-09-1024x683.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-09-1024x683.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-09-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-09-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-09.jpg 1417w\"/></figure>\n<figure class=\"wp-block-image aligncenter size-large\"><img alt=\"\" class=\"wp-image-11189\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-04-1024x683.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-04-1024x683.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-04-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-04-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/mesana-04.jpg 1417w\"/></figure>"}