ding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-07-1024x768.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-07-1024x768.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-07-300x225.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-07-768x576.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-07-1536x1152.jpg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-07.jpg 1600w\"/></figure>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-9560\" data-id=\"9560\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-08-1024x768.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-08-1024x768.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-08-300x225.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-08-768x576.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-08-1536x1152.jpg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/06/camaras-08.jpg 1600w\"/></figure>\n</figure>"}