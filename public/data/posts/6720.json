pg 1270w\"/></figure>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-6729\" data-id=\"6729\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-11-1024x682.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-11-1024x682.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-11-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-11-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-11.jpg 1280w\"/></figure>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-6727\" data-id=\"6727\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-12-1024x682.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-12-1024x682.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-12-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-12-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-12.jpg 1280w\"/></figure>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-6726\" data-id=\"6726\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-13-1024x682.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/03/monte-verde-13-1024x682.jpg 1024w, https://i0.wp.com/maullinultimobasti