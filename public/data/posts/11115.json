aullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-05-1536x1024.jpg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-05-2048x1366.jpg 2048w\"/></figure>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-11117\" data-id=\"11117\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-06-1024x683.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-06-1024x683.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-06-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-06-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-06-1536x1024.jpg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-06-2048x1366.jpg 2048w\"/></figure>\n<figure class=\"wp-block-image size-large\"><img alt=\"\" class=\"wp-image-11118\" data-id=\"11118\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-07-1024x683.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-07-1024x683.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-07-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-07-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/07/delegado-presidencial-07-1536x1024.jpg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-con