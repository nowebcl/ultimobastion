.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-04-08-at-5.34.05-PM-2-1024x682.jpeg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-04-08-at-5.34.05-PM-2-1024x682.jpeg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-04-08-at-5.34.05-PM-2-300x200.jpeg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-04-08-at-5.34.05-PM-2-767x511.jpeg 767w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-04-08-at-5.34.05-PM-2-1536x1024.jpeg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-04-08-at-5.34.05-PM-2.jpeg 1772w\"/></figure>\n</figure>\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-101 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image aligncenter size-large\"><img alt=\"\" class=\"wp-image-13409\" data-id=\"13409\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-05-25-at-3.18.46-PM-1024x683.jpeg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-05-25-at-3.18.46-PM-1024x683.jpeg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-05-25-at-3.18.46-PM-300x200.jpeg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-05-25-at-3.18.46-PM-768x512.jpeg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-05-25-at-3.18.46-PM-1536x1024.jpeg 1536w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/WhatsApp-Image-2026-05-25-at-3.18.46-PM.jpeg 1600w\"/></figure>\n</figure>\n<figure class=\"wp-block-image aligncenter size-large\"><img alt=\"\" class=\"wp-image-13410\" decoding=\"async\" loading=\"lazy\" onerror=\"this.onerror=null; (this.closest('figure') || this).style.display='none';\" src=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/inicio-tapas-y-fotos-1024x683.jpg\" srcset=\"https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/inicio-tapas-y-fotos-1024x683.jpg 1024w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/inicio-tapas-y-fotos-300x200.jpg 300w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/inicio-tapas-y-fotos-768x512.jpg 768w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/inicio-tapas-y-fotos-2048x1365.jpg 2048w, https://i0.wp.com/maullinultimobastion.cl/wp-content/uploads/2026/08/inicio-tapas-y-fotos-1536x1024.jpg 1536w\"/></figure>\n<h2 class=\"wp-block-heading\">Pronto más novedades del desarrollo de la iniciativa…..</h2>"}